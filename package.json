{
  "name": "decky-dsh",
  "version": "1.0.1",
  "description": "Decky Loader plugin that runs the DeepSeek Harness (dsh) agent on SteamOS handhelds.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit -p .",
    "test": "pnpm run test:frontend && pnpm run test:backend",
    "test:frontend": "node --test tests/frontend/*.test.mjs",
    "test:backend": "python -m unittest discover -s tests -v",
    "runtime:manifest": "python scripts/update_runtime_manifest.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/alan-liu/DeckyDSH.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deepseek",
    "agent"
  ],
  "author": "Qiming-Liu",
  "bugs": {
    "url": "https://gitlab.com/alan-liu/DeckyDSH/-/issues"
  },
  "homepage": "https://gitlab.com/alan-liu/DeckyDSH#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "qrcode-generator": "1.4.4",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
